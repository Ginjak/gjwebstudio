# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# Nothing here is required for the site to run in development.
# ---------------------------------------------------------------------------

# Canonical site URL. Used for canonical tags, hreflang, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://gjwebstudio.lt

# --- Contact form email (Resend) -------------------------------------------
# Create a free key at https://resend.com. If this is empty the form still
# works: submissions are validated and logged to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=labas@gjwebstudio.lt
CONTACT_FROM_EMAIL=Svetaine <no-reply@gjwebstudio.lt>

# --- Analytics --------------------------------------------------------------
# GA4 only loads AFTER the visitor accepts the "analytics" cookie category.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML tag verification code (content attribute only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Optional spam protection ----------------------------------------------
# Cloudflare Turnstile. Leave empty to disable (honeypot + rate limit remain).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
